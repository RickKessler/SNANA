# Example only: edit paths and survey depths before running SNANA.
CAT_DIR: /path/to/diffsky/catalog_release

HOSTLIB_FILE:
- DES_DIFFSKY.HOSTLIB 1.0

OVERRIDE_FILE: /path/to/decam_output/photometry.parquet
OVERRIDE_COLUMNS: des_g des_r des_i des_z

# Illustrative depths; replace with your survey values.
MAGERR_SNR5:
- des_g 25
- des_r 25
- des_i 25
- des_z 25

HOSTLIB_VARNAMES_MAP:
-  serial_tag      GALID           20.0f  # arbitrary serial number; not associated with catalog
-  redshift_true   ZTRUE_CMB       6.4f
-  D_A             D_A             .4e
-  vpec            VPEC            6.0f    # auto-compute from vx,vy,vz,ra,dec
-  des_g          g_obs           6.3f
-  des_r          r_obs           6.3f
-  des_i          i_obs           6.3f
-  des_z          z_obs           6.3f
-  des_g_err      g_obs_err         6.3f
-  des_r_err      r_obs_err         6.3f
-  des_i_err      i_obs_err         6.3f
-  des_z_err      z_obs_err         6.3f
-  ra              RA_GAL          11.6f
-  dec             DEC_GAL         11.6f
-  alpha_disk_Sersic   a0_Sersic       6.3f
-  beta_disk_Sersic    b0_Sersic       6.3f
-  n_disk_Sersic       n0_Sersic       .0f
-  alpha_bulge_Sersic  a1_Sersic       6.3f
-  beta_bulge_Sersic   b1_Sersic       6.3f
-  bulge_to_total      w1_Sersic       6.3f
-  n_bulge_Sersic      n1_Sersic       .0f
-  psi_disk        a_rot           6.1f
-  logsm_obs       LOGMASS         6.2f
-  logssfr_obs     LOGsSFR         6.2f
-  logsfr_obs      LOGSFR          6.2f  # internally computed

CUTWIN:
- ra              240  245
- dec              53   58
- logsm_obs        8    13
- redshift_true    0.05  1.80
#- des_r           0   28
